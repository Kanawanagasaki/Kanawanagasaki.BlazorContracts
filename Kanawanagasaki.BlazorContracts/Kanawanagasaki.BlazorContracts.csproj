<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>Kanawanagasaki.BlazorContracts</PackageId>
		<Version>1.1.0</Version>
		<Authors>Kanawanagasaki</Authors>
		<Description>Blazor contracts</Description>
		<PackageProjectUrl>https://github.com/Kanawanagasaki/Kanawanagasaki.BlazorContracts</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Kanawanagasaki/Kanawanagasaki.BlazorContracts</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
		<PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
		<PackageReference Include="Kanawanagasaki.Base122" Version="0.2.1" />
		<PackageReference Include="MessagePack" Version="3.1.12" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="" />
		<None Include="../LICENSE.txt" Pack="true" PackagePath="" />
	</ItemGroup>
</Project>
